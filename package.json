{
  "name": "skycycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "setup:https": "node scripts/setup-https.mjs",
    "dev:https": "vite --mode local-https --host 0.0.0.0 --port 5173 --strictPort",
    "cert:serve": "node scripts/serve-certificate.mjs",
    "build": "tsc -b && vite build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir .local/worker-check",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.160.0"
  }
}
